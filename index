    // ============================================================
    //  SISTEM NAMA TAMU
    // ============================================================
    function getGuestName() {
      const params = new URLSearchParams(window.location.search);
      let name = params.get('to');
      if (name) {
        name = decodeURIComponent(name);
        const element = document.createElement('div');
        element.textContent = name;
        return element.innerHTML;
      }
      return 'Tamu Undangan';
    }

    const guestName = getGuestName();

    // Render nama
    document.getElementById('guestNameCover').innerHTML = guestName;
    document.getElementById('guestNameWelcome').innerHTML = guestName;
    document.getElementById('coverNames').innerHTML = weddingData.brideName + ' &amp; ' + weddingData.groomName;
    document.getElementById('heroNames').innerHTML = weddingData.brideName + ' &amp; ' + weddingData.groomName;
    document.getElementById('brideName').textContent = weddingData.brideName;
    document.getElementById('groomName').textContent = weddingData.groomName;

    // ============================================================
    //  FUNGSI KOMENTAR DENGAN SUPABASE
    // ============================================================
    let comments = [];
    const commentsList = document.getElementById('commentsList');
    const commentFeedback = document.getElementById('commentFeedback');
    const loadingState = document.getElementById('loadingState');

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function renderComments() {
      if (comments.length === 0) {
        commentsList.innerHTML = `
            <div style="text-align:center; color:#8a9aaa; padding:40px; font-family: 'Lateef', serif; font-size:1.1rem;">
              <div style="font-size:2.4rem; margin-bottom:8px;">💐</div>
              Belum ada ucapan. Jadilah yang pertama untuk Hanifah & Farid!
            </div>
          `;
        return;
      }

      let html = '';
      comments.forEach(c => {
        const initial = c.name ? c.name.charAt(0).toUpperCase() : '?';
        const statusLabel = c.is_rsvp ? '♥ RSVP' : (c.status === 'Hadir' ? '✅ Hadir' : '❌ Tidak hadir');
        const time = c.created_at ? new Date(c.created_at).toLocaleString('id-ID') :
          c.time ? new Date(c.time).toLocaleString('id-ID') : 'Baru saja';

        html += `
            <div class="comment-item">
              <div class="avatar">${escapeHtml(initial)}</div>
              <div class="body">
                <div class="name">${escapeHtml(c.name || 'Anonim')} <span class="status">${statusLabel}</span></div>
                <div class="text">${escapeHtml(c.text || '')}</div>
                <div class="time">${escapeHtml(time)}</div>
              </div>
            </div>
          `;
      });
      commentsList.innerHTML = html;
    }

    async function loadComments() {
      try {
        loadingState.style.display = 'block';

        const { data, error } = await supabase
          .from('comments')
          .select('*')
          .order('created_at', { ascending: false });

        if (error) throw error;

        comments = data || [];
        renderComments();
        loadingState.style.display = 'none';

      } catch (error) {
        console.error('Error loading comments:', error);
        loadingState.innerHTML = `
            <div style="text-align:center; color:#b91c1c; padding:20px;">
              ⚠️ Gagal memuat komentar. Silakan refresh halaman.
              <br><small style="color:#8a9aaa;">${error.message || ''}</small>
            </div>
          `;
      }
    }

    async function addComment(name, status, text, isRsvp = false) {
      if (!name || !text) {
        commentFeedback.innerHTML = '<span style="color:#b91c1c;">⚠️ Nama dan ucapan harus diisi</span>';
        return false;
      }

      try {
        const { data, error } = await supabase
          .from('comments')
          .insert([{
            name: name.trim(),
            status: status || 'Hadir',
            text: text.trim(),
            is_rsvp: isRsvp,
            created_at: new Date().toISOString()
          }])
          .select();

        if (error) throw error;

        commentFeedback.innerHTML = '<span style="color:var(--gold);">✅ Ucapan terkirim!</span>';
        setTimeout(() => { commentFeedback.innerHTML = ''; }, 3000);
        return true;

      } catch (error) {
        console.error('Error adding comment:', error);
        commentFeedback.innerHTML = `<span style="color:#b91c1c;">⚠️ Gagal mengirim: ${error.message || 'Coba lagi'}</span>`;
        return false;
      }
    }

    // ============================================================
    //  REALTIME SUBSCRIPTION
    // ============================================================
    const channel = supabase
      .channel('comments-channel')
      .on(
        'postgres_changes', {
          event: 'INSERT',
          schema: 'public',
          table: 'comments'
        },
        (payload) => {
          if (payload.new) {
            const exists = comments.some(c => c.id === payload.new.id);
            if (!exists) {
              comments.unshift(payload.new);
              renderComments();
            }
          }
        }
      )
      .subscribe((status) => {
        console.log('Supabase subscription status:', status);
      });

    // ============================================================
    //  RSVP
    // ============================================================
    const rsvpSubmit = document.getElementById('rsvpSubmit');
    const rsvpFeedback = document.getElementById('rsvpFeedback');

    rsvpSubmit.addEventListener('click', async () => {
      const name = document.getElementById('rsvpName').value.trim();
      const attend = document.getElementById('rsvpAttend').value;
      const guests = document.getElementById('rsvpGuests').value;
      const message = document.getElementById('rsvpMessage').value.trim();

      if (!name) {
        rsvpFeedback.innerHTML = '<span style="color:#b91c1c;">⚠️ Nama harus diisi</span>';
        return;
      }

      const success = await addComment(name, attend, message || 'Hadir dalam acara', true);

      if (success) {
        rsvpFeedback.innerHTML = '<span style="color:var(--gold);">✅ Konfirmasi berhasil dikirim. Terima kasih!</span>';
        document.getElementById('rsvpName').value = '';
        document.getElementById('rsvpGuests').value = '1';
        document.getElementById('rsvpMessage').value = '';
        setTimeout(() => { rsvpFeedback.innerHTML = ''; }, 4000);
      }
    });

    // ============================================================
    //  KOMENTAR
    // ============================================================
    document.getElementById('commentSubmit').addEventListener('click', async () => {
      const name = document.getElementById('commentName').value.trim();
      const text = document.getElementById('commentText').value.trim();

      if (!name || !text) {
        commentFeedback.innerHTML = '<span style="color:#b91c1c;">⚠️ Nama dan ucapan harus diisi</span>';
        return;
      }

      await addComment(name, 'Hadir', text);
      document.getElementById('commentName').value = '';
      document.getElementById('commentText').value = '';
    });

    // ============================================================
    //  LOAD KOMENTAR
    // ============================================================
    loadComments();

    // ============================================================
    //  COVER
    // ============================================================
    const cover = document.getElementById('cover');
    const mainSite = document.getElementById('main-site');
    const btnOpen = document.getElementById('btnOpen');

    function openInvitation() {
      cover.classList.add('hidden');
      mainSite.classList.add('visible');
      document.body.style.overflow = 'auto';
      document.querySelectorAll('.fade-up').forEach(el => el.classList.add('visible'));

      const music = document.getElementById('bgMusic');
      music.play().catch(() => {
        console.log('Autoplay blocked, user must interact first');
      });
      document.getElementById('musicBtn').textContent = '⏸️';

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    btnOpen.addEventListener('click', function(e) {
      e.preventDefault();
      openInvitation();
    });

    // ============================================================
    //  COUNTDOWN - TARGET 05 SEPTEMBER 2026
    // ============================================================
    function updateCountdown() {
      const target = new Date(weddingData.weddingDate).getTime();
      const now = new Date().getTime();
      let diff = target - now;
      if (diff < 0) diff = 0;
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);
      document.getElementById('cdDays').textContent = String(days).padStart(2, '0');
      document.getElementById('cdHours').textContent = String(hours).padStart(2, '0');
      document.getElementById('cdMinutes').textContent = String(minutes).padStart(2, '0');
      document.getElementById('cdSeconds').textContent = String(seconds).padStart(2, '0');
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // ============================================================
    //  GALERI
    // ============================================================
    const galleryGrid = document.getElementById('galleryGrid');
    weddingData.galleryImages.forEach(src => {
      const img = document.createElement('img');
      img.src = src;
      img.alt = 'Gallery Photo';
      img.loading = 'lazy';
      img.onerror = function() {
        this.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400"><rect fill="%23e0e8f0" width="400" height="400"/><text x="200" y="200" font-family="Arial" font-size="40" text-anchor="middle" fill="%238a9aaa">📷</text></svg>';
      };
      img.addEventListener('click', () => {
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);display:flex;align-items:center;justify-content:center;z-index:9999;cursor:pointer;padding:20px;';
        const big = document.createElement('img');
        big.src = src;
        big.style.cssText = 'max-width:90%;max-height:90%;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,0.6);border:2px solid rgba(201,168,108,0.3);';
        big.onerror = function() {
          this.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="600" height="600" viewBox="0 0 600 600"><rect fill="%23e0e8f0" width="600" height="600"/><text x="300" y="300" font-family="Arial" font-size="60" text-anchor="middle" fill="%238a9aaa">📷</text></svg>';
        };
        overlay.appendChild(big);
        overlay.addEventListener('click', () => overlay.remove());
        document.body.appendChild(overlay);
      });
      galleryGrid.appendChild(img);
    });

    // ============================================================
    //  GIFT
    // ============================================================
    document.getElementById('copyBtn').addEventListener('click', () => {
      const account = weddingData.accountNumber;
      navigator.clipboard.writeText(account).then(() => {
        document.getElementById('copyFeedback').textContent = '✅ Nomor rekening berhasil disalin!';
        setTimeout(() => { document.getElementById('copyFeedback').textContent = ''; }, 3000);
      }).catch(() => {
        const el = document.createElement('textarea');
        el.value = account;
        document.body.appendChild(el);
        el.select();
        document.execCommand('copy');
        document.body.removeChild(el);
        document.getElementById('copyFeedback').textContent = '✅ Nomor rekening berhasil disalin!';
        setTimeout(() => { document.getElementById('copyFeedback').textContent = ''; }, 3000);
      });
    });

    // ============================================================
    //  MUSIK
    // ============================================================
    const musicBtn = document.getElementById('musicBtn');
    const bgMusic = document.getElementById('bgMusic');
    let isMusicPlaying = false;

    musicBtn.addEventListener('click', () => {
      if (isMusicPlaying) {
        bgMusic.pause();
        musicBtn.textContent = '🎵';
      } else {
        bgMusic.play().catch(() => {
          bgMusic.load();
          bgMusic.play().catch(() => {});
        });
        musicBtn.textContent = '⏸️';
      }
      isMusicPlaying = !isMusicPlaying;
    });

    // ============================================================
    //  SCROLL ANIMASI
    // ============================================================
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
    document.querySelectorAll('#couple, #events, #gallery, #rsvp, #comments, #gift').forEach(el => {
      el.classList.add('fade-up');
    });

    // ============================================================
    //  NAVIGASI
    // ============================================================
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    const sections = document.querySelectorAll('section[id]');
    const bottomLinks = document.querySelectorAll('.bottom-nav a');
    window.addEventListener('scroll', () => {
      let current = '';
      sections.forEach(section => {
        const top = section.offsetTop - 100;
        if (window.scrollY >= top) {
          current = section.getAttribute('id');
        }
      });
      bottomLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + current) {
          link.classList.add('active');
        }
      });
    });

    console.log('✨ Undangan Pernikahan Hanifah & Farid dengan Supabase & GitHub Pages siap!');
    console.log('📅 Tanggal: 05 September 2026');
    console.log('📁 Repository: weddinghf');
    console.log('👤 Tamu:', guestName);
  </script>

